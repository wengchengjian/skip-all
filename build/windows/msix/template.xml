<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="skip-all.exe"
        Arguments=""
        InstallLocation="C:\Program Files\SkipAll\SkipAll">
    </Installer>
    <PackageInformation
        PackageName="SkipAll"
        PackageDisplayName="SkipAll"
        PublisherName="CN=SkipAll"
        PublisherDisplayName="SkipAll"
        Version="0.1.0.0"
        PackageDescription="Skip game stories, cutscenes and time-wasting interactions.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.skipall.app"
                Description="Skip game stories, cutscenes and time-wasting interactions."
                DisplayName="SkipAll"
                ExecutableName="skip-all.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>SkipAll</DisplayName>
            <PublisherDisplayName>SkipAll</PublisherDisplayName>
            <Description>Skip game stories, cutscenes and time-wasting interactions.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="skip-all.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
